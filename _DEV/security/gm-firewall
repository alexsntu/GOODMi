#!/bin/sh
# Закрытые снаружи порты (2026-10-18, после инцидента с веб-шеллами): 3306 – MariaDB (внешних пользователей нет, сайты
# ходят через сокет), 21 – FTP (не используется, только перебор паролей), 6081 – Varnish (ни один сайт через него не идёт).
# Сам сервер (127.0.0.1, ::1, свои адреса) пускаем. Идемпотентно: cron раз в 10 минут (/etc/cron.d/gm-firewall) и при загрузке
# возвращает правила, если их снесли панель ISPmanager, fail2ban или перезагрузка. Открыть порт: убрать его из PORTS и выполнить
# iptables -D INPUT -p tcp --dport N -j GM_CLOSED (и ip6tables), см. /root/incident-2026-10-18/ и server-overrides/README.md.
# 2026-10-19: почта – 25/465/587 (exim) и 110/143/993/995 (dovecot): ящиков нет, писем 0, только перебор паролей (тысячи в
# сутки); CS-Cart шлёт письма через SMTP Яндекса (исходящие не затрагиваются), служебная почта cron – изнутри сервера.
PORTS="3306 21 6081 25 465 587 110 143 993 995 53"
# 2026-10-19: DNS (named, ISPmanager) – 15 зон, но ни один домен на этот сервер не делегирован (NGENIX, Яндекс, Cloudflare,
# Timeweb), сам сервер спрашивает внешние DNS хостинга (/etc/resolv.conf). DNS – в основном UDP, поэтому отдельный список.
UDP_PORTS="53"
OWN4="127.0.0.0/8 176.123.171.223 82.202.160.72"
for ipt in iptables ip6tables; do
    $ipt -N GM_CLOSED 2>/dev/null || true
    $ipt -F GM_CLOSED
    if [ "$ipt" = iptables ]; then
        for a in $OWN4; do $ipt -A GM_CLOSED -s "$a" -j RETURN; done
    else
        $ipt -A GM_CLOSED -s ::1 -j RETURN
    fi
    $ipt -A GM_CLOSED -j DROP
    for p in $PORTS; do
        $ipt -C INPUT -p tcp --dport "$p" -j GM_CLOSED >/dev/null 2>&1 || $ipt -I INPUT 1 -p tcp --dport "$p" -j GM_CLOSED
    done
    for p in $UDP_PORTS; do
        $ipt -C INPUT -p udp --dport "$p" -j GM_CLOSED >/dev/null 2>&1 || $ipt -I INPUT 1 -p udp --dport "$p" -j GM_CLOSED
    done
done

# Тестовые копии (2026-10-18, тест PHP 8.3 на копии боевых витрин): пользователь www-root (dev.maxmobiles.ru, dev.goodmi.ru,
# dev.mi92.ru) не ходит наружу совсем – ни СМС, ни МойСклад, ни БонусПлюс, ни почта, ни платежи, ни боевые сайты; только сам
# сервер через lo (база – через сокет). Снять: DEV_NO_OUT="" и iptables -D OUTPUT -m owner --uid-owner www-root -j GM_DEV_OUT
DEV_NO_OUT="www-root"
# DNS к серверам имён из /etc/resolv.conf разрешён: иначе каждое обращение наружу ждёт тайм-аутов резолвера (ответы REJECT на
# UDP ограничены ядром по частоте) и админка копии «тупит» по 3–36 с; сами соединения наружу по-прежнему обрываются сразу.
DNS4=$(awk '/^nameserver/ && $2 !~ /:/ {print $2}' /etc/resolv.conf)
for ipt in iptables ip6tables; do
    $ipt -N GM_DEV_OUT 2>/dev/null || true
    $ipt -F GM_DEV_OUT
    $ipt -A GM_DEV_OUT -o lo -j RETURN
    if [ "$ipt" = iptables ]; then
        for ns in $DNS4; do
            $ipt -A GM_DEV_OUT -d "$ns" -p udp --dport 53 -j RETURN
            $ipt -A GM_DEV_OUT -d "$ns" -p tcp --dport 53 -j RETURN
        done
    fi
    $ipt -A GM_DEV_OUT -p tcp -j REJECT --reject-with tcp-reset
    $ipt -A GM_DEV_OUT -j REJECT
    for u in $DEV_NO_OUT; do
        $ipt -C OUTPUT -m owner --uid-owner "$u" -j GM_DEV_OUT >/dev/null 2>&1 || $ipt -I OUTPUT 1 -m owner --uid-owner "$u" -j GM_DEV_OUT
    done
done
