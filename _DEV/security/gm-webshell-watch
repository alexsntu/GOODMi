#!/usr/bin/env python3
# Сторож кода сайтов (2026-10-18, после инцидента с веб-шеллами): раз в час (/etc/cron.d/gm-webshell-watch, :25)
# 1) проверяет все файлы с кодом в /var/www своими правилами ClamAV (/var/lib/clamav/gm-webshells.yar – официальные базы
#    и maldet закладки не узнают); 2) сравнивает список PHP-файлов и их контрольные суммы с прошлым запуском – новые
#    и изменённые файлы с кодом. Итог – /var/lib/gm-status/webshell.json, его читает сводка gm_cabinet.auth_status → Telegram.
# Список и суммы прошлого запуска – /var/lib/gm-status/php-baseline.json, журнал новых и изменённых файлов со временем –
# code-changes.jsonl (по нему сводка за окно). Первый запуск только запоминает состояние.
import hashlib, json, os, re, subprocess, sys, time, urllib.parse

ROOT = '/var/www'
RULES = '/var/lib/clamav/gm-webshells.yar'
STATE_DIR = '/var/lib/gm-status'
OUT = STATE_DIR + '/webshell.json'
BASE = STATE_DIR + '/php-baseline.json'
LOG = STATE_DIR + '/code-changes.jsonl'
CODE = re.compile(r'\.(php\d?|phtml|pht|phar|inc)$|(^|/)\.htaccess$|(^|/)\.user\.ini$', re.I)
SKIP = re.compile(r'/var/(cache|compiled)/|/var/www/[^/]+/data/(tmp|mod-tmp|logs)/')
MAX_LIST = 30

started = time.time()
files = {}
for dirpath, dirnames, filenames in os.walk(ROOT):
    if SKIP.search(dirpath + '/'):
        dirnames[:] = []
        continue
    for name in filenames:
        path = os.path.join(dirpath, name)
        if not CODE.search(path) or not os.path.isfile(path):
            continue
        try:
            h = hashlib.sha1()
            with open(path, 'rb') as f:
                for chunk in iter(lambda: f.read(1 << 20), b''):
                    h.update(chunk)
            files[path] = h.hexdigest()
        except OSError:
            pass

# Свои правила ClamAV – по тем же файлам
hits = []
error = ''
listfile = STATE_DIR + '/scan-list.txt'
with open(listfile, 'w') as f:
    f.write('\n'.join(files) + '\n')
try:
    r = subprocess.run(['nice', '-n', '15', 'clamscan', '--no-summary', '-i', '-d', RULES, '-f', listfile],
                       capture_output=True, text=True, timeout=1800)
    for line in r.stdout.splitlines():
        if line.endswith(' FOUND'):
            path, sig = line[:-6].rsplit(': ', 1)
            hits.append({'file': path, 'rule': sig.replace('YARA.', '').replace('.UNOFFICIAL', '')})
    if r.returncode not in (0, 1):
        error = 'clamscan: код ' + str(r.returncode) + ' ' + r.stderr.strip()[:200]
except Exception as e:
    error = 'clamscan: ' + str(e)[:200]

# Сравнение с прошлым запуском
first_run = not os.path.exists(BASE)
old = {}
if not first_run:
    try:
        with open(BASE) as f:
            old = json.load(f)
    except Exception:
        first_run = True
# Снимок файлов ядра var/snapshots/*.php CS-Cart пересоздаёт сам при каждом входе в админку (helpdesk_connector) – в «изменения
# кода» не пишем (2026-10-19, шум в тревогах); правилами ClamAV выше он проверяется, как все файлы
SNAPSHOT = re.compile(r'/var/snapshots/[^/]+\.php$')
added = sorted(p for p in files if p not in old and not SNAPSHOT.search(p)) if not first_run else []
changed = sorted(p for p in files if p in old and old[p] != files[p] and not SNAPSHOT.search(p)) if not first_run else []
removed = sorted(p for p in old if p not in files and not SNAPSHOT.search(p)) if not first_run else []

def info(path):
    try:
        st = os.stat(path)
        return {'file': path, 'owner': str(st.st_uid), 'mtime': time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime)),
                'ctime': time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_ctime))}
    except OSError:
        return {'file': path}

tmp = BASE + '.tmp'
with open(tmp, 'w') as f:
    json.dump(files, f)
os.replace(tmp, BASE)

# Журнал изменений: сводка за ночь читает всё, что попало в её окно, а не только последний запуск. Храним 5000 строк
now = int(time.time())
if added or changed:
    with open(LOG, 'a') as f:
        for kind, paths in (('added', added), ('changed', changed)):
            for p in paths:
                f.write(json.dumps(dict(info(p), ts=now, kind=kind), ensure_ascii=False) + '\n')
    with open(LOG) as f:
        lines = f.readlines()
    if len(lines) > 5000:
        with open(LOG, 'w') as f:
            f.writelines(lines[-5000:])
    os.chmod(LOG, 0o644)

# Журналы сайтов (2026-10-18, после снятия «записи для всех» и запрета PHP в папках данных): дочитываем с прошлого места
# 1) журналы ошибок – ошибки доступа к файлам (их не было ни одной до правки прав); 2) журналы запросов – отказы 403 по нашему
# правилу gm-no-php-in-data.conf, которые могли быть нужными: любые запросы к закрытым папкам данных и запросы к PHP-файлам
# в папках данных, которые реально есть на диске (несуществующие – сканеры, о них не сообщаем). Новое – в events.jsonl.
OFFSETS = STATE_DIR + '/log-offsets.json'
EVENTS = STATE_DIR + '/events.jsonl'
PERM = re.compile(r'permission denied|not writable|operation not permitted|unable to (create|write)', re.I)
DATA_DIR = re.compile(r'^/(bonusplus|logsklad|mc_log|sber)/', re.I)
PHP_IN_DATA = re.compile(r'^/(images|img|upgrades|var|wp-content|app/lib|design|js|css)/.*\.(php\d*|phtml|phar|pht|inc)(/|$)', re.I)
PHP_FILE = re.compile(r'^(.*?\.(?:php\d*|phtml|phar|pht|inc))(?:/|$)', re.I)
REQ = re.compile(r'^(\S+) .*?"(?:GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH) (\S+)[^"]*" (\d{3}) ')
SITE_ROOT = {'/var/www/maxmobiles/data/logs/': '/var/www/maxmobiles/data/www/maxmobiles.ru',
             '/var/www/www-root/data/logs/': '/var/www/www-root/data/www/dev.maxmobiles.ru'}
WATCHED = ('goodmi.ru', 'maxmobiles.ru', 'xione.ru', 'dev.maxmobiles.ru', 'dev.goodmi.ru', 'dev.mi92.ru')

# Заглушки CS-Cart из поставки (например images/index.php – только переадресация на ../index.php, чтобы не показывать список
# файлов папки): обращение к ним сканеров и так закрыто правилом, тревогу о них не пишем (2026-10-19)
STUB = re.compile(r'^\s*<\?php\s+header\(\s*[\'"]Location:\s*\.\./index\.php[\'"]\s*\);\s*(\?>)?\s*$')


def is_stub(path):
    try:
        if os.path.getsize(path) > 300:
            return False
        with open(path, encoding='utf-8', errors='replace') as f:
            return bool(STUB.match(f.read()))
    except OSError:
        return False


try:
    with open(OFFSETS) as f:
        offsets = json.load(f)
except Exception:
    offsets = {}
events = []
first_logs = not offsets
for logdir, site_root in SITE_ROOT.items():
    for site in WATCHED:
        for kind in ('error', 'access'):
            path = logdir + site + '.' + kind + '.log'
            if not os.path.isfile(path):
                continue
            st = os.stat(path)
            prev = offsets.get(path, {})
            start = prev.get('pos', 0) if prev.get('ino') == st.st_ino and prev.get('pos', 0) <= st.st_size else 0
            if first_logs:
                start = st.st_size  # первый запуск – только запоминаем конец журналов
            with open(path, 'rb') as f:
                f.seek(start)
                data = f.read(50 * 1024 * 1024)
                pos = f.tell()
            offsets[path] = {'ino': st.st_ino, 'pos': pos}
            for raw in data.decode('utf-8', 'replace').splitlines():
                if kind == 'error':
                    if PERM.search(raw) and 'No such file' not in raw:
                        events.append({'ts': int(time.time()), 'kind': 'perm_error', 'site': site, 'line': raw[:300]})
                    continue
                m = REQ.match(raw)
                if not m or m.group(3) != '403':
                    continue
                uri = urllib.parse.unquote(m.group(2).split('?', 1)[0])
                if DATA_DIR.search(uri):
                    events.append({'ts': int(time.time()), 'kind': 'blocked_data', 'site': site, 'ip': m.group(1), 'uri': uri[:200]})
                    continue
                script = PHP_FILE.match(uri) if PHP_IN_DATA.search(uri) else None
                target = os.path.normpath(site_root + script.group(1)) if script else ''
                if script and os.path.isfile(target) and not is_stub(target):
                    events.append({'ts': int(time.time()), 'kind': 'blocked_php', 'site': site, 'ip': m.group(1), 'uri': uri[:200]})
tmp = OFFSETS + '.tmp'
with open(tmp, 'w') as f:
    json.dump(offsets, f)
os.replace(tmp, OFFSETS)
if events:
    with open(EVENTS, 'a') as f:
        for e in events[:500]:
            f.write(json.dumps(e, ensure_ascii=False) + '\n')
    with open(EVENTS) as f:
        lines = f.readlines()
    if len(lines) > 5000:
        with open(EVENTS, 'w') as f:
            f.writelines(lines[-5000:])
    os.chmod(EVENTS, 0o644)

result = {
    'written_at': int(time.time()), 'seconds': round(time.time() - started, 1), 'files': len(files),
    'first_run': first_run, 'error': error, 'hits': hits,
    'added_count': len(added), 'added': [info(p) for p in added[:MAX_LIST]],
    'changed_count': len(changed), 'changed': [info(p) for p in changed[:MAX_LIST]],
    'removed_count': len(removed), 'removed': removed[:MAX_LIST],
    'log_events': len(events),
}
tmp = OUT + '.tmp'
with open(tmp, 'w') as f:
    json.dump(result, f, ensure_ascii=False)
os.chmod(tmp, 0o644)
os.replace(tmp, OUT)
print(time.strftime('%Y-%m-%d %H:%M:%S'), 'файлов', len(files), 'закладок', len(hits), 'новых', len(added), 'изменённых', len(changed),
      'удалённых', len(removed), 'событий в журналах', len(events), ('ОШИБКА ' + error) if error else '', 'за', result['seconds'], 'с')
sys.exit(0)
