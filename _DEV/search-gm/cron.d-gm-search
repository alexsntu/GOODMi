# GOODMi: свой поиск (2026-10-16). Индекс – каждые 2 часа в :15 ЧЁТНЫХ часов, после пересчёта остатков (moysklad.updateost
# в :01 чётных часов); индекс Maxmobiles – в :15 нечётных, чтобы сборки витрин не совпадали (2026-10-17).
# Частые запросы (Diginetica + журналы) и спрос за 90 дней (МойСклад GOODMi, ~12 мин) – раз в сутки с 05:40, затем индекс.
# Защита (2026-10-17, после зависания Manticore на 14 ч): все сборки обеих витрин – под общим замком /run/lock/search-index.lock
# (не идут одновременно; ждут замок до 10–20 мин, иначе запуск пропускается с записью в журнал) и с пределом времени (timeout),
# так что зависший запуск снимается сам и не копит очередь; любой сбой – строка «не завершён, код …» в журнале. Копия файла – _DEV/search-gm/cron.d-gm-search в репозитории GOODMi.
# Журнал – /root/gm-search/cron.log (у каждого запуска строка со временем). Откат – /root/gm-backups/2026-10-17-search-hang/gm-search
SHELL=/bin/sh
15 0-22/2 * * * root { flock -w 600 /run/lock/search-index.lock sh -c 'echo "== $(date "+\%F \%T") индекс"; timeout 600 /opt/php74/bin/php /root/gm-search/gm-search-index.php' || echo "== $(date "+\%F \%T") не завершён, код $? (1 – замок занят, 124 – снят по времени)"; } 2>&1 | grep -v "PHP Notice" >> /root/gm-search/cron.log
40 5 * * * root { flock -w 1200 /run/lock/search-index.lock sh -c 'echo "== $(date "+\%F \%T") запросы, спрос, индекс"; timeout 600 /opt/php74/bin/php /root/gm-search/gm-search-queries.php; timeout 1800 /opt/php74/bin/php /root/gm-search/gm-search-demand.php; timeout 600 /opt/php74/bin/php /root/gm-search/gm-search-index.php' || echo "== $(date "+\%F \%T") не завершён, код $? (1 – замок занят, 124 – снят по времени)"; } 2>&1 | grep -v "PHP Notice" >> /root/gm-search/cron.log
* * * * * root [ -f /var/www/maxmobiles/data/www/maxmobiles.ru/var/gm_search/rebuild.flag ] && { flock -w 600 /run/lock/search-index.lock sh -c 'if [ -f /var/www/maxmobiles/data/www/maxmobiles.ru/var/gm_search/rebuild.flag ]; then rm -f /var/www/maxmobiles/data/www/maxmobiles.ru/var/gm_search/rebuild.flag; echo "== $(date "+\%F \%T") индекс по кнопке"; timeout 600 /opt/php74/bin/php /root/gm-search/gm-search-index.php; fi' || echo "== $(date "+\%F \%T") не завершён, код $? (1 – замок занят, 124 – снят по времени)"; } 2>&1 | grep -v "PHP Notice" >> /root/gm-search/cron.log
