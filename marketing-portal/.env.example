# Порт, на котором слушает сервер
PORT=3000

# Токен для routines (Claude Code), которым они авторизуются при записи черновиков/состояния.
# Сгенерировать: openssl rand -hex 32
INGEST_API_TOKEN=your-long-random-token-here

# Логин для входа в веб-панель
ADMIN_USERNAME=your-username

# Пароль для входа в веб-панель — храним только bcrypt-хэш, не сам пароль.
# Сгенерировать: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replace-with-real-bcrypt-hash

# Секрет для подписи сессионной куки.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=your-long-random-session-secret

# Путь к файлу базы данных SQLite
DB_PATH=./data/portal.db

# API БонусПлюс (bonusplus.pro) — для раздела "Бонусы" (массовое списание).
# Ключ берётся в личном кабинете БонусПлюс: Настройки → Настройки интеграций → API.
BONUSPLUS_API_BASE=https://bonusplus.pro/api
BONUSPLUS_API_KEY=
