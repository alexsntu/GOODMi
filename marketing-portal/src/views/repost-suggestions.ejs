<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Предложение постов — Портал</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <h1><span>Портал</span></h1>
    <div class="topbar-actions">
      <a class="routine-link" href="/">← Черновики<% if (navCounts.drafts > 0) { %><span class="nav-badge"><%= navCounts.drafts %></span><% } %></a>
      <a class="routine-link" href="/topics">Темы статей →<% if (navCounts.topics > 0) { %><span class="nav-badge"><%= navCounts.topics %></span><% } %></a>
      <a class="routine-link" href="/plan">План →</a>
      <a class="routine-link" href="/promo-ideas">Идеи акций →<% if (navCounts.promoIdeas > 0) { %><span class="nav-badge"><%= navCounts.promoIdeas %></span><% } %></a>
      <a class="routine-link" href="/help">Хелп →</a>
      <form method="post" action="/logout"><button type="submit" class="btn-dismiss">Выйти</button></form>
    </div>
  </div>

  <div class="container">
    <h2 class="section-title">Предложение постов</h2>
    <div class="filters">
      <a href="?status=pending" class="<%= status === 'pending' ? 'active' : '' %>">Ожидают</a>
      <a href="?status=approved" class="<%= status === 'approved' ? 'active' : '' %>">Одобренные</a>
      <a href="?status=rejected" class="<%= status === 'rejected' ? 'active' : '' %>">Отклонённые</a>
      <a href="?status=all" class="<%= status === 'all' ? 'active' : '' %>">Все</a>
    </div>

    <% if (suggestions.length === 0) { %>
      <div class="empty">Предложений пока нет — программа проверяет каналы каждый час с 10:30 до 17:30 МСК по будням.</div>
    <% } %>

    <% suggestions.forEach(item => { %>
      <div class="draft" id="repost-<%= item.id %>">
        <div class="draft-meta">
          <% if (item.source_channel) { %><span class="tag"><%= item.source_channel %></span><% } %>
          <span><%= item.created_at %></span>
        </div>
        <div class="draft-text"><%= item.title %>

<%- item.summary.replace(/</g, '&lt;') %></div>
        <% if (item.source_url) { %>
          <p><a href="<%= item.source_url %>" target="_blank" rel="noopener"><%= item.source_url %></a></p>
        <% } %>
        <div class="draft-actions">
          <% if (item.status !== 'approved') { %>
            <form method="post" action="/repost-suggestions/<%= item.id %>/status" style="display:inline">
              <input type="hidden" name="status" value="approved">
              <button type="submit" class="btn-posted">Одобрить</button>
            </form>
          <% } %>
          <% if (item.status !== 'rejected') { %>
            <form method="post" action="/repost-suggestions/<%= item.id %>/status" style="display:inline">
              <input type="hidden" name="status" value="rejected">
              <button type="submit" class="btn-dismiss">Отклонить</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
