<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Вход — Портал</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="login-box">
    <h1>Привет</h1>
    <% if (error) { %>
      <div class="login-error"><%= error %></div>
    <% } %>
    <form method="post" action="/login">
      <input type="text" name="username" placeholder="Логин" autocomplete="username" autofocus required>
      <input type="password" name="password" placeholder="Пароль" autocomplete="current-password" required>
      <label class="login-remember">
        <input type="checkbox" name="remember" value="1" checked>
        Запомнить меня
      </label>
      <button type="submit">Войти</button>
    </form>
  </div>
</body>
</html>
