<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Вход — Маркетинг-портал GOODMi</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="login-box">
    <h1>Маркетинг-портал <strong style="color: var(--orange)">GOODMi</strong></h1>
    <% if (error) { %>
      <div class="login-error"><%= error %></div>
    <% } %>
    <form method="post" action="/login">
      <input type="password" name="password" placeholder="Пароль" autofocus required>
      <button type="submit">Войти</button>
    </form>
  </div>
</body>
</html>
