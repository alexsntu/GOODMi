# CS-Cart API Configuration
CSCART_API_URL=https://your-store.com/api
CSCART_API_EMAIL=admin@yourstore.com
CSCART_API_KEY=your-api-key-here

# PixelPlus (tools.pixelplus.ru) API Configuration
# Generate your token at: https://tools.pixelplus.ru → Account Settings → API
PIXELPLUS_API_TOKEN=your-pixelplus-token-here

# Optional: Set log level
LOG_LEVEL=info