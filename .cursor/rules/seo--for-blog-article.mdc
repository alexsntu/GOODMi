## JSON-LD — обязательные типы

`@graph` содержит:
- `BlogPosting` — headline, description (150–160 chars), datePublished, dateModified, author, publisher с logo, image (если есть), url, inLanguage: `"ru"`, keywords (3–7 слов), speakable, mainEntityOfPage
- `BreadcrumbList` — 3 уровня: Главная → Блог → Заголовок статьи
- `FAQPage` — те же 4 вопроса, что и HTML-секция FAQ (должны совпадать)

```json
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "https://goodmi.ru/blog-xiaomi-na-russkom/SLUG/#article",
      "headline": "ЗАГОЛОВОК",
      "description": "ОПИСАНИЕ 150–160 СИМВОЛОВ",
      "datePublished": "YYYY-MM-DD",
      "dateModified": "YYYY-MM-DD",
      "inLanguage": "ru",
      "url": "https://goodmi.ru/blog-xiaomi-na-russkom/SLUG/",
      "keywords": ["ключевое слово", "Xiaomi", "GOODMi"],
      "author": { "@type": "Organization", "name": "GOODMi", "url": "https://goodmi.ru" },
      "publisher": {
        "@type": "Organization",
        "name": "GOODMi",
        "logo": { "@type": "ImageObject", "url": "https://goodmi.ru/images/logos/goodmi-logo.png" }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://goodmi.ru/blog-xiaomi-na-russkom/SLUG/" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".gm-article-key-facts", ".gm-faq"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://goodmi.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Блог", "item": "https://goodmi.ru/blog-xiaomi-na-russkom/" },
        { "@type": "ListItem", "position": 3, "name": "ЗАГОЛОВОК", "item": "https://goodmi.ru/blog-xiaomi-na-russkom/SLUG/" }
      ]
    }
  ]
}
```

